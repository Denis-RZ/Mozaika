{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mozaika": {
    "ApiPrefix": "/api",
    "MaxUploadMb": 25,
    "Pricing": {
      "Currency": "RUB",
      "SetupPrice": 0,
      "PricePerChip": 1.75,
      "PricePerUsedColor": 120,
      "ComplexityThresholdColors": 12,
      "ExtraPricePerColorAboveThreshold": 70,
      "GroutPricePerSquareMeter": 0,
      "MinOrderPrice": 0
    },
    "Auth": {
      "SessionHours": 24,
      "AllowInsecureFallbackPasswords": false,
      "Users": [
        {
          "Username": "admin",
          "PasswordEnv": "MOZAIKA_AUTH_ADMIN_PASSWORD",
          "DisplayName": "Администратор",
          "Role": "admin",
          "IsActive": true
        },
        {
          "Username": "customer",
          "PasswordEnv": "MOZAIKA_AUTH_CUSTOMER_PASSWORD",
          "DisplayName": "Заказчик",
          "Role": "customer",
          "IsActive": true
        },
        {
          "Username": "viewer",
          "PasswordEnv": "MOZAIKA_AUTH_VIEWER_PASSWORD",
          "DisplayName": "Просмотр",
          "Role": "viewer",
          "IsActive": true
        }
      ]
    },
    "CorsOrigins": ["http://localhost:5173", "http://localhost:8080", "http://127.0.0.1:5173", "http://127.0.0.1:8080"],
    "Database": {
      "Provider": "sqlite",
      "ConnectionString": "Data Source=../data/mozaika.local.db",
      "Echo": false
    }
  }
}
